{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "TasteWise design tokens. Source of truth for marketing web, legal pages, and mapping to Flutter lib/app/theme.",
  "meta": {
    "brand": "TasteWise",
    "version": "1.0.0",
    "grid": "8px",
    "layout": "12-column",
    "flutter": {
      "colors": "lib/app/theme/app_colors.dart",
      "type": "lib/app/theme/app_typography.dart",
      "space": "lib/app/theme/app_spacing.dart",
      "theme": "lib/app/theme/app_theme.dart"
    }
  },
  "color": {
    "brand": {
      "primary": {
        "$type": "color",
        "$value": "#4A0E0E",
        "$description": "Maroon. Light-mode interactive. Flutter AppColors.primary. Contrast on cream ~15:1."
      },
      "primaryDark": {
        "$type": "color",
        "$value": "#2F0808",
        "$description": "Pressed / deepest maroon. AppColors.primaryDark."
      },
      "primaryLight": {
        "$type": "color",
        "$value": "#F3E4D4",
        "$description": "Soft maroon wash. Containers, selected chip tracks. AppColors.primaryLight."
      },
      "secondary": {
        "$type": "color",
        "$value": "#2A1A18",
        "$description": "Espresso. On-accent and dark headlines. AppColors.secondary."
      },
      "secondaryLight": {
        "$type": "color",
        "$value": "#EDE4D8",
        "$description": "Warm taupe wash. AppColors.secondaryLight."
      },
      "accent": {
        "$type": "color",
        "$value": "#B8956A",
        "$description": "Champagne. Dark-mode interactive, stamps, stars, focus rings. Not body text on cream (fails WCAG AA). AppColors.accent."
      },
      "accentDark": {
        "$type": "color",
        "$value": "#8C6E48",
        "$description": "Pressed champagne. AppColors.accentDark."
      },
      "accentLight": {
        "$type": "color",
        "$value": "#F3E8D8",
        "$description": "Champagne wash. AppColors.accentLight / feedAccentSoft."
      },
      "onAccent": {
        "$type": "color",
        "$value": "#2F0808",
        "$description": "Text/icons on champagne. AppColors.onAccent."
      },
      "cream": {
        "$type": "color",
        "$value": "#FDF8F1",
        "$description": "Paper. Light canvas and dark-mode primary text. AppColors.cream."
      },
      "charcoal": {
        "$type": "color",
        "$value": "#1A0C0C",
        "$description": "Ink. Light-mode primary text. AppColors.charcoal."
      }
    },
    "surface": {
      "light": { "$type": "color", "$value": "#FFFBF6", "$description": "Cards in light. AppColors.surfaceLight." },
      "backgroundLight": { "$type": "color", "$value": "#FDF8F1", "$description": "Scaffold. AppColors.backgroundLight." },
      "outlineLight": { "$type": "color", "$value": "#E2D5C6", "$description": "Hairline. AppColors.outlineLight." },
      "dark": { "$type": "color", "$value": "#2A1616", "$description": "Cards in dark. AppColors.surfaceDark." },
      "backgroundDark": { "$type": "color", "$value": "#140A0A", "$description": "Scaffold dark. AppColors.backgroundDark." },
      "outlineDark": { "$type": "color", "$value": "#4A3330", "$description": "Hairline dark. AppColors.outlineDark." },
      "charcoalLight": { "$type": "color", "$value": "#2A1616", "$description": "Raised dark surface. AppColors.charcoalLight." }
    },
    "text": {
      "primaryLight": { "$type": "color", "$value": "#1A0C0C", "$description": "Contrast on cream ~15.4:1 AAA." },
      "secondaryLight": { "$type": "color", "$value": "#6B5752", "$description": "Contrast on cream ~6.1:1 AA." },
      "primaryDark": { "$type": "color", "$value": "#FDF8F1", "$description": "Contrast on backgroundDark ~15.6:1 AAA." },
      "secondaryDark": { "$type": "color", "$value": "#C9B8B0", "$description": "Contrast on backgroundDark ~9.2:1 AAA." }
    },
    "semantic": {
      "error": { "$type": "color", "$value": "#DC2626", "$description": "Destructive. ~4.6:1 on cream — use 16px+ or pair with icon." },
      "success": { "$type": "color", "$value": "#15803D", "$description": "Confirmed, booked. ~4.8:1 on cream." },
      "warning": { "$type": "color", "$value": "#EAB308", "$description": "Rating star / caution. Decorative on cream; pair with charcoal text." },
      "info": { "$type": "color", "$value": "#4A0E0E", "$description": "Informational uses brand maroon, never a foreign blue." }
    }
  },
  "gradient": {
    "brand": {
      "$type": "gradient",
      "$value": "linear-gradient(135deg, #5C1616 0%, #3A0A0A 100%)",
      "$description": "AppColors.brandGradient. Seals, download band only."
    },
    "stageLight": {
      "$type": "gradient",
      "$value": "linear-gradient(180deg, #FDF8F1 0%, #F7F0E6 50%, #F0E6D8 100%)"
    },
    "stageDark": {
      "$type": "gradient",
      "$value": "linear-gradient(180deg, #1C0F0F 0%, #140A0A 50%, #1A1010 100%)"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": ["Fraunces", "Iowan Old Style", "Palatino Linotype", "Palatino", "serif"],
      "$description": "Display, headlines, titles. GoogleFonts.fraunces. Optical size 144."
    },
    "body": {
      "$type": "fontFamily",
      "$value": ["Source Sans 3", "Source Sans Pro", "Segoe UI", "system-ui", "sans-serif"],
      "$description": "UI, body, labels. GoogleFonts.sourceSans3."
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.display}", "fontWeight": 800, "fontSize": "clamp(2.5rem, 1.6rem + 3.2vw, 4rem)", "lineHeight": 1.08, "letterSpacing": "-0.04em" },
      "$description": "Level 1. Hero only."
    },
    "headline": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.display}", "fontWeight": 700, "fontSize": "clamp(2rem, 1.5rem + 1.8vw, 2.75rem)", "lineHeight": 1.12, "letterSpacing": "-0.03em" },
      "$description": "Level 2. Section titles. Flutter headlineLarge 30."
    },
    "title": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.display}", "fontWeight": 700, "fontSize": "clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem)", "lineHeight": 1.2, "letterSpacing": "-0.02em" },
      "$description": "Level 3. Flutter titleLarge 22."
    },
    "subtitle": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.body}", "fontWeight": 700, "fontSize": "clamp(1.0625rem, 1rem + 0.25vw, 1.25rem)", "lineHeight": 1.35, "letterSpacing": "-0.01em" },
      "$description": "Level 4. Flutter titleMedium 16."
    },
    "bodyLg": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.body}", "fontWeight": 400, "fontSize": "clamp(1.0625rem, 1rem + 0.2vw, 1.125rem)", "lineHeight": 1.55 },
      "$description": "Level 5. Marketing lede, legal body."
    },
    "body": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.body}", "fontWeight": 400, "fontSize": "1rem", "lineHeight": 1.5 },
      "$description": "Level 6. Flutter bodyLarge 16 / bodyMedium 14 — web uses 16 for AA."
    },
    "label": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.body}", "fontWeight": 700, "fontSize": "0.9375rem", "lineHeight": 1.3 },
      "$description": "Level 7. Buttons. Flutter labelLarge 15."
    },
    "caption": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.body}", "fontWeight": 600, "fontSize": "0.8125rem", "lineHeight": 1.4 },
      "$description": "Level 8. Meta, helper. Flutter bodySmall 12 — web 13px for AA."
    },
    "overline": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.body}", "fontWeight": 700, "fontSize": "0.75rem", "lineHeight": 1.3, "letterSpacing": "0.08em", "textTransform": "uppercase" },
      "$description": "Level 9. Eyebrows, section kicker."
    }
  },
  "spacing": {
    "0": { "$type": "dimension", "$value": "0px" },
    "0-5": { "$type": "dimension", "$value": "4px", "$description": "Exception. Flutter AppSpacing.xxs. Hairline padding only." },
    "1": { "$type": "dimension", "$value": "8px", "$description": "Base unit. Flutter AppSpacing.xs." },
    "1-5": { "$type": "dimension", "$value": "12px", "$description": "Legacy Flutter AppSpacing.sm. Prefer 8 or 16 on web." },
    "2": { "$type": "dimension", "$value": "16px", "$description": "Flutter AppSpacing.md." },
    "3": { "$type": "dimension", "$value": "24px", "$description": "Flutter AppSpacing.lg." },
    "4": { "$type": "dimension", "$value": "32px", "$description": "Flutter AppSpacing.xl." },
    "5": { "$type": "dimension", "$value": "40px" },
    "6": { "$type": "dimension", "$value": "48px", "$description": "Flutter AppSpacing.xxl." },
    "8": { "$type": "dimension", "$value": "64px" },
    "10": { "$type": "dimension", "$value": "80px" },
    "12": { "$type": "dimension", "$value": "96px" },
    "16": { "$type": "dimension", "$value": "128px" }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "4px", "$description": "AppRadius.xs" },
    "sm": { "$type": "dimension", "$value": "8px", "$description": "AppRadius.sm" },
    "md": { "$type": "dimension", "$value": "12px", "$description": "AppRadius.md" },
    "lg": { "$type": "dimension", "$value": "16px", "$description": "AppRadius.lg — inputs." },
    "xl": { "$type": "dimension", "$value": "24px", "$description": "AppRadius.xl" },
    "xxl": { "$type": "dimension", "$value": "28px", "$description": "AppRadius.xxl — cards." },
    "pill": { "$type": "dimension", "$value": "999px", "$description": "Buttons, chips, nav pills." }
  },
  "borderWidth": {
    "hairline": { "$type": "dimension", "$value": "0.5px", "$description": "Cards, dividers. Use 1px below 2x DPR if needed." },
    "thin": { "$type": "dimension", "$value": "1px" },
    "focus": { "$type": "dimension", "$value": "2px" }
  },
  "size": {
    "buttonHeight": { "$type": "dimension", "$value": "54px", "$description": "Filled/outlined buttons. Min 44px tap." },
    "iconButton": { "$type": "dimension", "$value": "44px" },
    "navHeight": { "$type": "dimension", "$value": "68px" },
    "avatarSm": { "$type": "dimension", "$value": "32px" },
    "avatarMd": { "$type": "dimension", "$value": "48px" },
    "avatarLg": { "$type": "dimension", "$value": "72px" }
  },
  "shadow": {
    "none": { "$type": "shadow", "$value": "none" },
    "soft": {
      "$type": "shadow",
      "$value": "0 16px 40px rgba(74, 14, 14, 0.10)"
    },
    "device": {
      "$type": "shadow",
      "$value": "0 40px 80px rgba(26, 12, 12, 0.18)"
    }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "150ms", "$description": "AppDurations.fast" },
    "normal": { "$type": "duration", "$value": "250ms", "$description": "AppDurations.normal" },
    "slow": { "$type": "duration", "$value": "400ms", "$description": "AppDurations.slow" },
    "ease": { "$type": "cubicBezier", "$value": [0.25, 0.1, 0.25, 1] },
    "emphasized": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  },
  "breakpoint": {
    "sm": { "$type": "dimension", "$value": "480px" },
    "md": { "$type": "dimension", "$value": "768px", "$description": "Aligns with Flutter tablet shortestSide 600 for web." },
    "lg": { "$type": "dimension", "$value": "1024px" },
    "xl": { "$type": "dimension", "$value": "1280px" }
  },
  "grid": {
    "columns": { "$type": "number", "$value": 12 },
    "gutter": { "$type": "dimension", "$value": "24px" },
    "margin": {
      "sm": { "$type": "dimension", "$value": "16px" },
      "md": { "$type": "dimension", "$value": "24px" },
      "lg": { "$type": "dimension", "$value": "48px" }
    },
    "maxWidth": { "$type": "dimension", "$value": "1120px", "$description": "Marketing canvas. Flutter contentMax is 720 for in-app lists." },
    "legalMax": { "$type": "dimension", "$value": "720px" }
  },
  "zIndex": {
    "base": { "$type": "number", "$value": 0 },
    "nav": { "$type": "number", "$value": 40 },
    "sheet": { "$type": "number", "$value": 50 },
    "modal": { "$type": "number", "$value": 60 },
    "toast": { "$type": "number", "$value": 70 }
  }
}
