rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Post media: owner-only writes, JPEG up to 5 MB, public-read to
    // signed-in users.
    match /posts/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Profile avatars (used from the Profile milestone onward).
    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Chat photos: the uid path segment must match the uploader.
    // (Read access is via download URL; participant checks live in
    // Firestore rules for the message docs.)
    match /chats/{chatId}/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
