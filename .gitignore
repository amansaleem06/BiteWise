# Firebase local / secrets — client configs ARE committed (needed for CI).
# Do not commit service-account JSON or .env files.
.firebase/
*.env
*.env.*
service-account*.json
*-firebase-adminsdk-*.json

# Node (Cloud Functions)
functions/node_modules/
functions/lib/

