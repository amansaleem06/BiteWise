rules_version = '2';

// Assumed data model (default Firestore database):
// - users/{uid}: private account/contact/preferences; owner + admin read only.
// - publicProfiles/{uid}: validated, non-sensitive profile projection.
// - users/{uid}/{bookmarks,reposts,following,followers,tokens,aiPlans,
//   private,notifications,blocked,blockedBy}: per-user state with explicit rules.
// - posts, stories, restaurants, chats: signed-in product content.
// - reports, moderationAudit: reporter writes; moderators read/resolve.
// Cloud Functions use the Admin SDK and maintain counters/public projections.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    // Blocks are bilateral for interaction permission. Public feed queries
    // remain readable; presentation/data providers filter blocked authors.
    function canInteract(uid) {
      return isSignedIn()
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(uid))
        && !exists(/databases/$(database)/documents/users/$(uid)/blocked/$(request.auth.uid));
    }

    function hasAcceptedTerms() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('termsAcceptedVersion', '') == '2026-09-21';
    }

    function canParticipate() {
      return hasAcceptedTerms()
        && !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false);
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function canMessageUser(uid) {
      let peer = get(/databases/$(database)/documents/publicProfiles/$(uid)).data;
      let privacy = peer.get('messagePrivacy', 'everyone');
      return canInteract(uid) && (privacy == 'everyone'
        || (privacy == 'followers'
          && exists(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid))));
    }

    function isRestaurantOwner() {
      return isSignedIn() && userRole() == 'restaurantOwner';
    }

    function verificationNotSelfGranted() {
      return request.resource.data.get('businessVerificationStatus', 'pending')
          == resource.data.get('businessVerificationStatus', 'pending')
        || (
          request.resource.data.get('businessVerificationStatus', 'pending')
            == 'pending'
          && resource.data.get('businessVerificationStatus', 'pending')
            != 'verified'
        );
    }

    function ownedRestaurantUnchanged() {
      return request.resource.data.get('ownedRestaurantId', '')
        == resource.data.get('ownedRestaurantId', '');
    }

    function validOptionalString(data, field, maxLength) {
      return !(field in data)
        || data[field] == null
        || (data[field] is string && data[field].size() <= maxLength);
    }

    function isValidPrivateUser(data) {
      return data.keys().hasOnly([
          'email', 'displayName', 'displayNameLower', 'username',
          'usernameLower', 'photoUrl', 'bio', 'phone', 'role',
          'businessName', 'businessAddress', 'businessPhone',
          'businessEmail', 'businessVerificationStatus',
          'ownedRestaurantId', 'pendingClaimRestaurantId',
          'pendingClaimCode', 'messagePrivacy', 'dietaryPreferences',
          'termsAcceptedVersion', 'termsAcceptedAt',
          'emailVerified', 'followerCount', 'followingCount', 'postCount',
          'suspended', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'email', 'displayName', 'displayNameLower', 'role',
          'messagePrivacy', 'emailVerified', 'followerCount',
          'followingCount', 'postCount', 'createdAt', 'updatedAt'
        ])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 50
        && data.displayNameLower is string && data.displayNameLower.size() <= 50
        && data.role in ['user', 'restaurantOwner', 'admin']
        && data.messagePrivacy in ['everyone', 'followers', 'nobody']
        && data.emailVerified is bool
        && data.followerCount is int && data.followerCount >= 0
        && data.followingCount is int && data.followingCount >= 0
        && data.postCount is int && data.postCount >= 0
        && data.get('suspended', false) is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && validOptionalString(data, 'username', 30)
        && validOptionalString(data, 'usernameLower', 30)
        && validOptionalString(data, 'photoUrl', 2048)
        && validOptionalString(data, 'bio', 160)
        && validOptionalString(data, 'phone', 40)
        && validOptionalString(data, 'businessName', 80)
        && validOptionalString(data, 'businessAddress', 240)
        && validOptionalString(data, 'businessPhone', 40)
        && validOptionalString(data, 'businessEmail', 254)
        && validOptionalString(data, 'ownedRestaurantId', 200)
        && validOptionalString(data, 'pendingClaimRestaurantId', 200)
        && validOptionalString(data, 'pendingClaimCode', 80)
        && (!( 'businessVerificationStatus' in data)
          || data.businessVerificationStatus in ['pending', 'verified', 'rejected'])
        && (!( 'dietaryPreferences' in data)
          || (data.dietaryPreferences is list && data.dietaryPreferences.size() <= 20))
        && (!( 'termsAcceptedVersion' in data)
          || data.termsAcceptedVersion is string)
        && (!( 'termsAcceptedAt' in data)
          || data.termsAcceptedAt is timestamp);
    }

    function isValidPublicProfile(data) {
      return data.keys().hasOnly([
          'displayName', 'displayNameLower', 'username', 'usernameLower',
          'photoUrl', 'bio', 'role', 'businessName',
          'businessVerificationStatus', 'ownedRestaurantId',
          'messagePrivacy', 'followerCount', 'followingCount', 'postCount',
          'suspended', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'displayName', 'displayNameLower', 'role', 'messagePrivacy',
          'followerCount', 'followingCount', 'postCount', 'createdAt',
          'updatedAt'
        ])
        && data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 50
        && data.displayNameLower is string && data.displayNameLower.size() <= 50
        && data.role in ['user', 'restaurantOwner', 'admin']
        && data.messagePrivacy in ['everyone', 'followers', 'nobody']
        && data.followerCount is int && data.followerCount >= 0
        && data.followingCount is int && data.followingCount >= 0
        && data.postCount is int && data.postCount >= 0
        && data.get('suspended', false) is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && validOptionalString(data, 'username', 30)
        && validOptionalString(data, 'usernameLower', 30)
        && validOptionalString(data, 'photoUrl', 2048)
        && validOptionalString(data, 'bio', 160)
        && validOptionalString(data, 'businessName', 80)
        && validOptionalString(data, 'ownedRestaurantId', 200)
        && (!( 'businessVerificationStatus' in data)
          || data.businessVerificationStatus in ['pending', 'verified', 'rejected']);
    }

    function publicMatchesPrivate(publicData, privateData) {
      return publicData.displayName == privateData.displayName
        && publicData.displayNameLower == privateData.displayNameLower
        && publicData.get('username', null) == privateData.get('username', null)
        && publicData.get('usernameLower', null) == privateData.get('usernameLower', null)
        && publicData.get('photoUrl', null) == privateData.get('photoUrl', null)
        && publicData.get('bio', null) == privateData.get('bio', null)
        && publicData.role == privateData.role
        && publicData.get('businessName', null) == privateData.get('businessName', null)
        && publicData.get('businessVerificationStatus', null)
          == privateData.get('businessVerificationStatus', null)
        && publicData.get('ownedRestaurantId', null)
          == privateData.get('ownedRestaurantId', null)
        && publicData.messagePrivacy == privateData.messagePrivacy
        && publicData.followerCount == privateData.followerCount
        && publicData.followingCount == privateData.followingCount
        && publicData.postCount == privateData.postCount
        && publicData.get('suspended', false) == privateData.get('suspended', false)
        && publicData.createdAt == privateData.createdAt
        && publicData.updatedAt == privateData.updatedAt;
    }

    function publicProfileIsSynced(uid) {
      return existsAfter(/databases/$(database)/documents/publicProfiles/$(uid))
        && publicMatchesPrivate(
          getAfter(/databases/$(database)/documents/publicProfiles/$(uid)).data,
          request.resource.data
        );
    }

    function isTermsAcceptanceOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['termsAcceptedVersion', 'termsAcceptedAt'])
        && request.resource.data.termsAcceptedVersion == '2026-09-21'
        && request.resource.data.termsAcceptedAt == request.time;
    }

    // ---------- Users ----------
    match /users/{uid} {
      // Account/contact/preferences are private. Other users read the safe
      // projection at publicProfiles/{uid}.
      allow read: if isSelf(uid) || isAdmin();

      // Self-serve signup: foodie (`user`) or business (`restaurantOwner`).
      allow create: if isSelf(uid)
        && isValidPrivateUser(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !request.resource.data.get('suspended', false)
        && request.resource.data.get('ownedRestaurantId', '') == ''
        && request.resource.data.get('businessVerificationStatus', 'pending') == 'pending'
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 50
        && (
          request.resource.data.role == 'user'
          || (request.resource.data.role == 'restaurantOwner'
            && request.resource.data.businessName is string
            && request.resource.data.businessName.size() >= 2
            && request.resource.data.businessName.size() <= 80)
        )
        && publicProfileIsSynced(uid);

      // A user may update their own profile but never role or counters.
      // Business owners may attach verification details and a claimed restaurant.
      allow update: if isValidPrivateUser(request.resource.data)
        && (isAdmin()
        || (isSelf(uid) && (isTermsAcceptanceOnly() || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'displayNameLower', 'username', 'usernameLower',
            'photoUrl', 'bio', 'phone', 'businessName', 'businessAddress',
            'businessPhone', 'businessEmail', 'businessVerificationStatus',
            'pendingClaimRestaurantId', 'pendingClaimCode', 'messagePrivacy',
            'dietaryPreferences', 'emailVerified', 'updatedAt'
          ])
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.followerCount == resource.data.followerCount
          && request.resource.data.followingCount == resource.data.followingCount
          && request.resource.data.postCount == resource.data.postCount
          && verificationNotSelfGranted()
          && ownedRestaurantUnchanged()
          && request.resource.data.get('suspended', false) == resource.data.get('suspended', false)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.emailVerified == resource.data.emailVerified
            || (request.resource.data.emailVerified == true
              && request.auth.token.email_verified == true))
          && request.resource.data.get('businessVerificationStatus', 'pending')
            != 'rejected'
          && publicProfileIsSynced(uid)
        ))));

      // Self-delete required for App Store account deletion (Guideline 5.1.1).
      // Cascade cleanup of posts/follows continues in Cloud Functions.
      allow delete: if isAdmin() || isSelf(uid);
    }

    match /publicProfiles/{uid} {
      allow read: if isSignedIn();

      // New accounts and profile edits write private + public documents in
      // one atomic operation. The projection must exactly match the private
      // source for every public field.
      allow create: if isSelf(uid)
        && isValidPublicProfile(request.resource.data)
        && existsAfter(/databases/$(database)/documents/users/$(uid))
        && publicMatchesPrivate(
          request.resource.data,
          getAfter(/databases/$(database)/documents/users/$(uid)).data
        );
      allow update: if isSelf(uid)
        && isValidPublicProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'displayNameLower', 'username', 'usernameLower',
          'photoUrl', 'bio', 'businessName', 'businessVerificationStatus',
          'messagePrivacy', 'updatedAt'
        ])
        && existsAfter(/databases/$(database)/documents/users/$(uid))
        && publicMatchesPrivate(
          request.resource.data,
          getAfter(/databases/$(database)/documents/users/$(uid)).data
        );
      allow delete: if false;
    }

    // ---------- User subcollections ----------
    match /users/{uid}/bookmarks/{postId} {
      allow read, write: if isSelf(uid);
    }

    match /users/{uid}/reposts/{postId} {
      allow read: if isSignedIn();
      allow create, delete: if isSelf(uid);
    }

    match /users/{uid}/following/{targetUid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid) && uid != targetUid && canParticipate() && canInteract(targetUid);
      allow delete: if isSelf(uid);
    }

    match /users/{uid}/followers/{followerUid} {
      allow read: if isSignedIn();
      // Follower may create/delete their own reverse edge (same as following).
      allow create: if isSelf(followerUid) && uid != followerUid && canParticipate() && canInteract(uid);
      allow delete: if isSelf(followerUid);
    }

    // FCM device tokens — private to their owner.
    match /users/{uid}/tokens/{token} {
      allow read, write: if isSelf(uid);
    }

    // AI diet plans — private to their owner.
    match /users/{uid}/aiPlans/{planId} {
      allow read, write: if isSelf(uid);
    }

    // Height / weight / goal — never on the public profile doc.
    match /users/{uid}/private/{docId} {
      allow read, write: if isSelf(uid);
    }

    // Notifications — actor may create for someone else; owner reads/marks.
    match /users/{uid}/notifications/{notificationId} {
      allow read, delete: if isSelf(uid);
      allow create: if isSignedIn()
        && canParticipate() && canInteract(uid)
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorId != uid
        && request.resource.data.type in ['like', 'comment', 'follow', 'repost']
        && request.resource.data.read == false
        && request.resource.data.actorName is string;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read'])
        && request.resource.data.read == true;
    }

    function ownsRestaurant(restaurantId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/restaurants/$(restaurantId))
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId
            == request.auth.uid;
    }

    // ---------- Posts ----------
    match /posts/{postId} {
      allow read: if isSignedIn();

      allow create: if canParticipate()
        && !request.resource.data.get('moderationHidden', false)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.restaurantId is string
        && request.resource.data.restaurantName is string
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 2200
        && request.resource.data.media is list
        && request.resource.data.media.size() >= 1
        && request.resource.data.media.size() <= 10
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.shareCount == 0
        && request.resource.data.trendingScore == 0
        && (!('rating' in request.resource.data)
            || request.resource.data.rating == null
            || (request.resource.data.rating >= 1.0
                && request.resource.data.rating <= 5.0
                && request.resource.data.restaurantId.size() >= 1));

      allow update: if canParticipate() && canInteract(resource.data.authorId)
        && !resource.data.get('moderationHidden', false)
        && request.resource.data.get('moderationHidden', false) == resource.data.get('moderationHidden', false) && (
        (request.auth.uid == resource.data.authorId
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.likeCount == resource.data.likeCount
          && request.resource.data.commentCount == resource.data.commentCount
          && request.resource.data.shareCount == resource.data.shareCount)
        || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['likeCount'])
            && (request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
                || request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1))
        || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['commentCount', 'latestCommentAuthor', 'latestCommentText'])
            && (request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
                || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1))
        || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['commentCount'])
            && (request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
                || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1))
        || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['shareCount'])
            && request.resource.data.shareCount == resource.data.get('shareCount', 0) + 1)
        || (resource.data.restaurantId is string
            && resource.data.restaurantId.size() > 0
            && resource.data.get('asRestaurantId', '') == ''
            && ownsRestaurant(resource.data.restaurantId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['mentionApproved', 'mentionHidden'])
            && request.resource.data.authorId == resource.data.authorId)
      );

      allow delete: if isSignedIn()
        && (
          request.auth.uid == resource.data.authorId
          || isAdmin()
          || (
            resource.data.get('asRestaurantId', '') is string
            && resource.data.get('asRestaurantId', '') != ''
            && ownsRestaurant(resource.data.asRestaurantId)
          )
        );

      match /likes/{uid} {
        allow read: if isSignedIn();
        allow create: if isSelf(uid) && canParticipate()
          && canInteract(get(/databases/$(database)/documents/posts/$(postId)).data.authorId);
        allow delete: if isSelf(uid);
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if canParticipate()
          && canInteract(get(/databases/$(database)/documents/posts/$(postId)).data.authorId)
          && !request.resource.data.get('moderationHidden', false)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 500;
        allow delete: if isSignedIn()
          && (request.auth.uid == resource.data.authorId || isAdmin());
        allow update: if false;
      }
    }

    // ---------- Restaurants ----------
    match /restaurants/{restaurantId} {
      allow read: if isSignedIn();

      // Unclaimed stubs (from posting) or claimed pages (business signup).
      allow create: if isSignedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.nameLower == request.resource.data.name.lower()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.followerCount == 0
        && request.resource.data.postCount == 0
        && request.resource.data.claimed == false
        && request.resource.data.ownerId == null;

      // Owners may edit profile fields; counters stay locked except rating
      // aggregates / postCount bumped by any signed-in publisher.
      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.claimed == resource.data.claimed
          && request.resource.data.followerCount == resource.data.get('followerCount', 0)
          && request.resource.data.postCount == resource.data.get('postCount', 0)
          && request.resource.data.get('ratingSum', 0) == resource.data.get('ratingSum', 0)
          && request.resource.data.get('ratingCount', 0) == resource.data.get('ratingCount', 0))
        || (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['ratingSum', 'ratingCount', 'ratingAvg', 'postCount', 'updatedAt'])
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.claimed == resource.data.claimed
          && request.resource.data.followerCount == resource.data.get('followerCount', 0));
      allow delete: if isAdmin();

      match /followers/{uid} {
        allow read: if isSignedIn();
        allow create, delete: if isSelf(uid);
      }

      // Owner-only proof for a listing. Clients may submit pending
      // requests; only admin / Cloud Functions can mark approved.
      match /claimRequests/{uid} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid)
          && isRestaurantOwner()
          && request.resource.data.status == 'pending'
          && request.resource.data.claimCode is string
          && request.resource.data.claimCode.size() >= 8
          && request.resource.data.proofUrl is string
          && request.resource.data.proofUrl.size() > 8;
        allow update: if isAdmin()
          || (isSelf(uid)
            && resource.data.status == 'pending'
            && request.resource.data.status == 'pending'
            && request.resource.data.claimCode == resource.data.claimCode);
        allow delete: if isAdmin()
          || (isSelf(uid) && resource.data.status == 'pending');
      }
    }

    // ---------- Chats ----------
    match /chats/{chatId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }

      function chatAllowed() {
        return isParticipant() && canInteract(resource.data.participants[0] == request.auth.uid
          ? resource.data.participants[1] : resource.data.participants[0]);
      }

      // Missing docs have no resource. A get() used to check "does this
      // chat exist?" must be allowed, or starting a first conversation
      // fails with permission-denied.
      allow get: if isSignedIn() && (
        resource == null || request.auth.uid in resource.data.participants
      );
      allow list: if isParticipant();

      // Creating a chat: exactly two participants including yourself,
      // the doc id must be the sorted uid pair, and the other person
      // must allow new messages (everyone / followers).
      allow create: if canParticipate()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && chatId == request.resource.data.participants[0]
            + '_' + request.resource.data.participants[1]
        && request.resource.data.participants[0]
            < request.resource.data.participants[1]
        && canMessageUser(
             request.resource.data.participants[0] == request.auth.uid
               ? request.resource.data.participants[1]
               : request.resource.data.participants[0]
           );

      // Participants may update receipts/typing/lastMessage/info but never
      // the participant list itself.
      allow update: if chatAllowed() && canParticipate()
        && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        allow read: if isSignedIn()
          && request.auth.uid in parentChat().participants;

        allow create: if canParticipate()
          && canInteract(parentChat().participants[0] == request.auth.uid
            ? parentChat().participants[1] : parentChat().participants[0])
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in parentChat().participants
          && (
            (request.resource.data.type == 'text'
              && request.resource.data.text is string
              && request.resource.data.text.size() >= 1
              && request.resource.data.text.size() <= 2000)
            ||
            (request.resource.data.type == 'image'
              && request.resource.data.imageUrl is string)
            ||
            (request.resource.data.type == 'audio'
              && request.resource.data.audioUrl is string
              && request.resource.data.durationMs is int
              && request.resource.data.durationMs > 0
              && request.resource.data.durationMs <= 180000)
          );

        // Messages are immutable.
        allow update, delete: if false;
      }
    }

    // ---------- Reservations ----------
    match /reservations/{reservationId} {
      function restaurantOwner(restaurantId) {
        return get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId;
      }

      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.userId
            || request.auth.uid == restaurantOwner(resource.data.restaurantId)
            || isAdmin());

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.restaurantId is string
        && request.resource.data.partySize is int
        && request.resource.data.partySize >= 1
        && request.resource.data.partySize <= 20
        && request.resource.data.dateTime is timestamp
        && request.resource.data.dateTime > request.time;

      // Diner may cancel their own active booking; the restaurant owner
      // may confirm/reject/complete. Nothing else changes.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
        && (
          (request.auth.uid == resource.data.userId
            && request.resource.data.status == 'cancelled'
            && (resource.data.status == 'pending'
                || resource.data.status == 'confirmed'))
          ||
          (request.auth.uid == restaurantOwner(resource.data.restaurantId)
            && request.resource.data.status in
                ['confirmed', 'rejected', 'completed'])
          || isAdmin()
        );

      allow delete: if isAdmin();
    }

    // ---------- Stories (24h photos) ----------
    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if canParticipate()
        && !request.resource.data.get('moderationHidden', false)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.mediaUrl is string
        && request.resource.data.authorName is string
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0;
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.authorId;
      allow update: if canParticipate() && canInteract(resource.data.authorId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likeCount', 'commentCount'])
        && request.resource.data.authorId == resource.data.authorId;

      match /likes/{uid} {
        allow read: if isSignedIn();
        allow create: if isSelf(uid) && canParticipate()
          && canInteract(get(/databases/$(database)/documents/stories/$(storyId)).data.authorId);
        allow delete: if isSelf(uid);
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if canParticipate()
          && !request.resource.data.get('moderationHidden', false)
          && canInteract(get(/databases/$(database)/documents/stories/$(storyId)).data.authorId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 280;
        allow delete: if isSignedIn()
          && request.auth.uid == resource.data.authorId;
        allow update: if false;
      }
    }

    // Future collections (dishes)
    // are added per-milestone with their own rules. Default deny:

    // Content reports — signed-in users may file; only admins read.
    match /reports/{reportId} {
      allow get: if isAdmin() || (isSignedIn()
        && (resource == null || resource.data.reporterId == request.auth.uid));
      allow list: if isAdmin();
      allow create: if canParticipate()
        && request.resource.data.keys().hasOnly(['reporterId', 'targetType', 'targetId', 'targetUserId', 'reason', 'status', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.targetUserId != request.auth.uid
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in
          ['post', 'user', 'message', 'story', 'comment']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 500
        && request.resource.data.targetUserId is string
        && request.resource.data.reason in ['Spam', 'Harassment', 'Hate or abuse', 'Sexual or inappropriate content', 'Impersonation', 'Other']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 2
        && request.resource.data.reason.size() <= 80
        && request.resource.data.status == 'open';
      allow update, delete: if isAdmin();
    }

    match /users/{uid}/blocked/{targetUid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid) && uid != targetUid
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/users/$(targetUid)/blockedBy/$(uid));
      allow delete: if isSelf(uid)
        && !existsAfter(/databases/$(database)/documents/users/$(targetUid)/blockedBy/$(uid));
    }

    match /users/{uid}/blockedBy/{blockerUid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(blockerUid) && uid != blockerUid
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/users/$(blockerUid)/blocked/$(uid));
      allow delete: if isSelf(blockerUid)
        && !existsAfter(/databases/$(database)/documents/users/$(blockerUid)/blocked/$(uid));
    }

    match /moderationAudit/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
